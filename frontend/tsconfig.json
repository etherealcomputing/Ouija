{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // Excluded from type-checking: the legacy v0 component pile and the unused
  // vendored shadcn UI primitives (only button/slider/switch are imported — they
  // re-enter the program clean via those imports). Keeps `next build`'s strict
  // "type errors fail the build" posture meaningful for product code while not
  // failing on dead boilerplate that depends on uninstalled packages.
  "exclude": ["node_modules", "components/*.tsx", "components/providers", "components/ui", "hooks/use-toast.ts", "tests", "vitest.config.ts"]
}
